---
import AuthLayout from "../../layouts/AuthLayout.astro";
import avatars from "../../data/avatars.json";

// NOTE: this step is no longer in the live onboarding chain — #18 made the
// avatar auto-derive from the nickname, and /onboarding/nickname now lands
// straight on "/". The page is kept because it is still reachable by direct
// URL and is the starting point if a real picker returns with the pixel-art
// set. Restyled onto AuthLayout (2026-08-19) with the rest of the flow so it
// can't sit here quietly rotting off-palette.
---
<AuthLayout
  title="Pick an avatar · Policy Wonk"
  description="Pick an avatar for Policy Wonk."
  eyebrow="Step 2 of 2"
  headline="Pick an avatar"
  subhead="Placeholder set for now. Real pixel-art avatars land soon."
  width="wide"
>
  <p id="welcome-line" class="mb-6 hidden text-sm text-[var(--color-text-muted)]">
    Hi <span id="nickname-value" class="font-medium text-[var(--color-text-soft)]"></span>.
  </p>

  <fieldset id="avatar-grid" class="mb-8 grid grid-cols-3 gap-4 sm:grid-cols-4">
      <legend class="sr-only">Choose your avatar</legend>
      {avatars.map((a) => (
        <label
          class="cursor-pointer block"
          data-slug={a.slug}
        >
          <input
            type="radio"
            name="avatar"
            value={a.slug}
            class="sr-only peer"
          />
          <div
            class="flex aspect-square items-center justify-center rounded-full bg-[var(--color-charcoal)] font-serif text-3xl text-[var(--color-bg)] transition peer-checked:ring-4 peer-checked:ring-[var(--color-functional-marigold)] peer-checked:ring-offset-2 peer-focus:outline-2 peer-focus:outline-[var(--color-functional-marigold)]"
          >
            {a.displayName}
          </div>
        </label>
      ))}
    </fieldset>

    <button
      type="button"
      id="submit-btn"
      disabled
      class="w-full bg-[var(--color-charcoal)] px-6 py-3 font-semibold text-[var(--color-bg)] hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40"
    >
      Continue to Policy Wonk
    </button>

  <div id="error-box" class="mt-5 hidden border-l-2 border-[var(--color-functional-red)] bg-[var(--color-functional-red)]/5 px-4 py-3">
    <p class="text-sm" id="error-text"></p>
  </div>
</AuthLayout>

<script>
  type MeResponse = {
    ok: boolean;
    user: null | { id: string; email: string; nickname: string | null; avatar_slug: string | null };
  };

  const grid = document.getElementById("avatar-grid") as HTMLFieldSetElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const errorBox = document.getElementById("error-box") as HTMLDivElement;
  const errorText = document.getElementById("error-text") as HTMLParagraphElement;
  const welcomeLine = document.getElementById("welcome-line") as HTMLParagraphElement;
  const nicknameValue = document.getElementById("nickname-value") as HTMLSpanElement;

  function showError(msg: string) {
    errorText.textContent = msg;
    errorBox.classList.remove("hidden");
  }

  function clearError() {
    errorBox.classList.add("hidden");
  }

  // Gate: must be logged in AND past step 1.
  (async function gate() {
    let me: MeResponse;
    try {
      const res = await fetch("/api/me", { credentials: "same-origin" });
      me = (await res.json()) as MeResponse;
    } catch {
      window.location.replace("/login");
      return;
    }
    if (!me.user) {
      window.location.replace("/login");
      return;
    }
    if (!me.user.nickname) {
      window.location.replace("/onboarding/nickname");
      return;
    }
    if (me.user.avatar_slug) {
      window.location.replace("/");
      return;
    }
    nicknameValue.textContent = me.user.nickname;
    welcomeLine.classList.remove("hidden");
  })();

  grid.addEventListener("change", () => {
    submitBtn.disabled = !getSelectedSlug();
  });

  function getSelectedSlug(): string | null {
    const checked = grid.querySelector<HTMLInputElement>('input[name="avatar"]:checked');
    return checked?.value ?? null;
  }

  submitBtn.addEventListener("click", async () => {
    clearError();
    const slug = getSelectedSlug();
    if (!slug) return;
    submitBtn.disabled = true;
    submitBtn.textContent = "Saving…";
    try {
      const res = await fetch("/api/me/profile/avatar", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ avatar_slug: slug }),
      });
      const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
      if (res.ok && data.ok) {
        window.location.assign("/");
        return;
      }
      showError(
        data.error === "invalid_avatar_slug"
          ? "That avatar isn't available. Pick another."
          : "Something went wrong. Try again.",
      );
    } catch {
      showError("Couldn't reach the server. Check your connection and try again.");
    } finally {
      submitBtn.disabled = !getSelectedSlug();
      submitBtn.textContent = "Continue to Policy Wonk";
    }
  });
</script>
