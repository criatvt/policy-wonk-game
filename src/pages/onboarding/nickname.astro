---
import AuthLayout from "../../layouts/AuthLayout.astro";

// Palette note (2026-08-19): this page previously used raw Tailwind
// greys (text-gray-500, border-gray-400, bg-black, bg-red-50) instead of
// the palette tokens, so it drifted off-theme as the tokens changed.
// Everything here now goes through the vars in global.css.
---
<AuthLayout
  title="Pick a nickname · Policy Wonk"
  description="Set your display name for Policy Wonk."
  eyebrow="Last step"
  headline="Pick a nickname"
  subhead="This is how you'll show up in your play history and on shared scores."
>
  <p id="email-line" class="mb-6 hidden text-sm text-[var(--color-text-muted)]">
    Setting up <span id="email-value" class="font-medium text-[var(--color-text-soft)]"></span>.
  </p>

  <form id="nickname-form" class="space-y-3" novalidate>
    <div>
      <label for="nickname" class="mb-2 block text-sm font-medium">Nickname</label>
      <input
        type="text"
        id="nickname"
        name="nickname"
        required
        minlength="3"
        maxlength="24"
        autocomplete="off"
        spellcheck="false"
        class="w-full border border-[var(--color-border-soft)] bg-[var(--color-bg-soft)] px-4 py-3 text-[15px] focus:border-[var(--color-charcoal)] focus:outline-none"
        placeholder="3–24 characters"
      />
      <p class="mt-2 text-xs text-[var(--color-text-muted)]">Letters, numbers, spaces, hyphens, underscores, apostrophes.</p>
    </div>
    <button
      type="submit"
      id="submit-btn"
      class="w-full bg-[var(--color-charcoal)] px-6 py-3 font-semibold text-[var(--color-bg)] hover:opacity-90 disabled:cursor-wait disabled:opacity-50"
    >
      Continue
    </button>
  </form>

  <div id="error-box" class="mt-5 hidden border-l-2 border-[var(--color-functional-red)] bg-[var(--color-functional-red)]/5 px-4 py-3">
    <p class="text-sm" id="error-text"></p>
  </div>
</AuthLayout>

<script>
  type MeResponse = {
    ok: boolean;
    user: null | { id: string; email: string; nickname: string | null; avatar_slug: string | null };
  };

  const form = document.getElementById("nickname-form") as HTMLFormElement;
  const input = document.getElementById("nickname") as HTMLInputElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const errorBox = document.getElementById("error-box") as HTMLDivElement;
  const errorText = document.getElementById("error-text") as HTMLParagraphElement;
  const emailLine = document.getElementById("email-line") as HTMLParagraphElement;
  const emailValue = document.getElementById("email-value") as HTMLSpanElement;

  function showError(msg: string) {
    errorText.textContent = msg;
    errorBox.classList.remove("hidden");
  }

  function clearError() {
    errorBox.classList.add("hidden");
  }

  // Gate: if not logged in, send to /login. If profile already complete,
  // skip to the right destination so users can't be stuck on this step.
  (async function gate() {
    let me: MeResponse;
    try {
      const res = await fetch("/api/me", { credentials: "same-origin" });
      me = (await res.json()) as MeResponse;
    } catch {
      window.location.replace("/login");
      return;
    }
    if (!me.user) {
      window.location.replace("/login");
      return;
    }
    if (me.user.nickname) {
      // Avatar is auto-derived from the nickname now (#18); there's no
      // separate picker step. Returning users with a nickname go straight
      // home regardless of whether avatar_slug is set on their old record.
      window.location.replace("/");
      return;
    }
    emailValue.textContent = me.user.email;
    emailLine.classList.remove("hidden");
    input.focus();
  })();

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearError();
    const nickname = input.value.trim();
    if (nickname.length < 3 || nickname.length > 24) {
      showError("Nickname must be 3–24 characters.");
      return;
    }
    submitBtn.disabled = true;
    submitBtn.textContent = "Saving…";
    try {
      const res = await fetch("/api/me/profile/nickname", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ nickname }),
      });
      const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
      if (res.ok && data.ok) {
        // Server auto-derives the avatar from the nickname (#18) — no
        // picker step. Land on home.
        window.location.assign("/");
        return;
      }
      const msg =
        data.error === "invalid_nickname_length"
          ? "Nickname must be 3–24 characters."
          : data.error === "invalid_nickname_chars"
            ? "Use letters, numbers, spaces, hyphens, underscores, or apostrophes."
            : data.error === "nickname_blocked"
              ? "Try a different nickname."
              : "Something went wrong. Try again.";
      showError(msg);
    } catch {
      showError("Couldn't reach the server. Check your connection and try again.");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Continue";
    }
  });
</script>
