---
import BaseLayout from "../layouts/BaseLayout.astro";

// TestFlight invitation for the native iOS build (PolicyWonk-iOS, a sibling
// repo). Kept as a constant so the link appears once.
const TESTFLIGHT_URL = "https://testflight.apple.com/join/AubAzGnh";
---
<BaseLayout title="Policy Wonk" zone="game">
  <section class="py-12 md:py-20 flex flex-col gap-12 md:gap-16">
    <header class="flex flex-col gap-6">
      <span class="self-start text-xs uppercase tracking-[0.2em] px-3 py-1 border border-[var(--color-border-soft)] text-[var(--color-text-soft)]">
        Quiz on Public Policy Fundamentals
      </span>
      <h1 class="font-serif text-6xl md:text-8xl lg:text-9xl leading-[0.95] tracking-tight font-semibold">
        Policy <span class="text-[var(--color-functional-marigold)] italic">Wonk.</span>
      </h1>
    </header>

    <dl class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-8 border-y border-[var(--color-border)] py-8">
      <div class="flex flex-col gap-1">
        <dt class="text-xs uppercase tracking-widest text-[var(--color-text-muted)]">Questions</dt>
        <dd class="font-serif text-4xl md:text-5xl text-[var(--color-functional-marigold)] font-semibold">15</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="text-xs uppercase tracking-widest text-[var(--color-text-muted)]">Tiers</dt>
        <dd class="font-serif text-4xl md:text-5xl text-[var(--color-functional-marigold)] font-semibold">4</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="text-xs uppercase tracking-widest text-[var(--color-text-muted)]">Lifelines</dt>
        <dd class="font-serif text-4xl md:text-5xl text-[var(--color-functional-marigold)] font-semibold">3</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="text-xs uppercase tracking-widest text-[var(--color-text-muted)]">Top score</dt>
        <dd class="font-serif text-4xl md:text-5xl text-[var(--color-functional-marigold)] font-semibold">1 cr</dd>
      </div>
    </dl>

    <div class="flex flex-col items-center gap-5">
      <a
        href="/play"
        class="btn-physical px-12 py-5 rounded-[var(--radius-cta)] bg-[var(--color-charcoal)] text-[var(--color-bg)] text-xl font-semibold"
      >
        Play →
      </a>
      <p class="text-sm text-[var(--color-text-muted)] max-w-md text-center leading-relaxed">
        Best played on a desktop or laptop. The ladder and the lifelines want room to breathe.
        <br />
        On a phone, try the iOS app below.
      </p>
      <p class="text-sm text-[var(--color-text-muted)] max-w-md text-center leading-relaxed">
        For The Takshashila Institution alumni, students, and the policy curious.
        <br />
        Built on alumni notes, GCPP study material, and publicly available information.
      </p>
    </div>

    <!-- Native iOS build. Shown to everyone so non-Apple readers know it
         exists, with the opening line swapped for visitors already on an
         iPhone or iPad (see the script at the foot of this file). -->
    <section class="flex flex-col gap-4 border-t border-[var(--color-border)] pt-6">
      <h2 class="text-xs uppercase tracking-widest text-[var(--color-text-muted)]">Also on iPhone</h2>

      <div class="flex flex-col gap-1">
        <p class="font-serif text-base text-[var(--color-text)]">Policy Wonk for iOS</p>
        <p class="text-sm text-[var(--color-text-soft)]" data-ios-lede>
          There is a native iOS app. It is in open testing on TestFlight, so you can try it before it reaches the App Store.
        </p>
      </div>

      <a
        href={TESTFLIGHT_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-physical self-start inline-flex items-center gap-2 px-6 py-3 rounded-[var(--radius-cta)] bg-[var(--color-charcoal)] text-[var(--color-bg)] text-sm font-semibold"
      >
        {/* Apple mark, drawn inline so it inherits currentColor in both themes. */}
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08ZM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25Z" />
        </svg>
        Check it out on TestFlight →
      </a>

      <details class="text-sm text-[var(--color-text-soft)]">
        <summary class="cursor-pointer text-[var(--color-functional-marigold)] underline decoration-2 underline-offset-2 hover:opacity-80">
          How to join a TestFlight beta
        </summary>
        <ol class="mt-3 flex flex-col gap-2 pl-5 list-decimal">
          <li>Install Apple's free TestFlight app from the App Store.</li>
          <li>Open the invitation link above on your iPhone or iPad.</li>
          <li>Tap Accept, then Install.</li>
          <li>Policy Wonk lands on your home screen with an orange dot beside the name. That dot just marks a test build.</li>
        </ol>
        <p class="mt-3">
          Test builds expire after 90 days. TestFlight will prompt you when a newer one is ready.
        </p>
      </details>
    </section>

    <section class="flex flex-col gap-4 border-t border-[var(--color-border)] pt-6">
      <h2 class="text-xs uppercase tracking-widest text-[var(--color-text-muted)]">What's new</h2>
      {/* Icon cards, one line of copy each. The icons are inline strokes in
          the functional teal so they read as wayfinding, not decoration. */}
      <ul class="grid md:grid-cols-3 gap-3 list-none p-0 m-0">
        <li class="flex flex-col gap-2 rounded-[var(--radius-cta)] border border-[var(--color-border)] bg-[var(--color-bg-panel)] p-4">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-functional-marigold)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {/* Graduation cap */}
            <path d="M12 4 2 9l10 5 10-5-10-5Z" />
            <path d="M6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5" />
            <path d="M22 9v5" />
          </svg>
          <p class="font-serif text-base text-[var(--color-text)] m-0">Ask Your Professor</p>
          <p class="text-sm text-[var(--color-text-soft)] m-0">
            The AI lifeline, reborn. Professor Takshi lectures a little, then points you right. From Q6.
          </p>
        </li>
        <li class="flex flex-col gap-2 rounded-[var(--radius-cta)] border border-[var(--color-border)] bg-[var(--color-bg-panel)] p-4">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-functional-marigold)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {/* Open notebook */}
            <path d="M12 6c-1.5-1.3-3.6-2-6-2-1 0-2 .13-3 .4V19c1-.27 2-.4 3-.4 2.4 0 4.5.7 6 2 1.5-1.3 3.6-2 6-2 1 0 2 .13 3 .4V4.4c-1-.27-2-.4-3-.4-2.4 0-4.5.7-6 2Z" />
            <path d="M12 6v14.6" />
          </svg>
          <p class="font-serif text-base text-[var(--color-text)] m-0">
            <a href="/notes" class="underline decoration-2 underline-offset-2 hover:opacity-80">Revision notes →</a>
          </p>
          <p class="text-sm text-[var(--color-text-soft)] m-0">
            Per-topic notes for all eleven modules. Complete a module's quiz to unlock its notes.
          </p>
        </li>
        <li class="flex flex-col gap-2 rounded-[var(--radius-cta)] border border-[var(--color-border)] bg-[var(--color-bg-panel)] p-4">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-functional-marigold)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {/* Envelope */}
            <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
            <path d="m3.5 7 8.5 6 8.5-6" />
          </svg>
          <p class="font-serif text-base text-[var(--color-text)] m-0">
            <a href="/login" class="underline decoration-2 underline-offset-2 hover:opacity-80">Optional sign in →</a>
          </p>
          <p class="text-sm text-[var(--color-text-soft)] m-0">
            Email link, no passwords. Saves history and unlocks notes. Guests stay first class.
          </p>
        </li>
      </ul>
    </section>
  </section>
</BaseLayout>

<script>
  // Swap the iOS lede for visitors already on an Apple handheld. iPadOS 13+
  // reports itself as "MacIntel", so the touch-point count is what separates
  // an iPad from a desktop Mac.
  const isIOS =
    /iPad|iPhone|iPod/.test(navigator.userAgent) ||
    (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);

  if (isIOS) {
    const lede = document.querySelector<HTMLParagraphElement>("[data-ios-lede]");
    if (lede) {
      lede.textContent =
        "You are on an Apple device, so you can run the native app. It is in open testing on TestFlight. Joining takes a minute.";
    }
  }
</script>
