---
import AuthLayout from "../layouts/AuthLayout.astro";

const errorParam = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  missing_token: "The sign-in link was incomplete. Try again.",
  invalid_or_expired: "That sign-in link has expired or already been used. Send yourself a fresh one.",
  server: "Something went wrong on our end. Try again in a moment.",
};
const errorMessage = errorParam ? (errorMessages[errorParam] ?? "Sign-in failed. Try again.") : null;

// "Direct sign-in mode" (when ?show=email is in the URL — sent by the
// header's Sign in button) is applied CLIENT-SIDE, not server-side. Astro
// with output: 'static' evaluates Astro.url at build time, where the
// build has no query params, so a server-side conditional always
// resolves to false. The inline script below reads window.location at
// request time and toggles the chooser/form accordingly. Same pattern
// as /auth/confirm.
//
// Layout note (2026-08-19): the masthead now lives in AuthLayout, and
// the headline/subhead carry the shared `auth-headline` / `auth-subhead`
// ids that direct mode rewrites.
---
<AuthLayout
  title="Sign in · Policy Wonk"
  description="Sign in to Policy Wonk, or play as a guest with no commitment."
  eyebrow="Welcome"
  headline="Two ways in."
  subhead="Sign in to keep your history and unlock notes. Or go straight to the game — no email, no commitment."
  width="wide"
>
  {errorMessage && (
    <div
      role="alert"
      class="mb-6 border-l-2 border-[var(--color-functional-red)] bg-[var(--color-functional-red)]/5 px-4 py-3 text-sm"
    >
      {errorMessage}
    </div>
  )}

  {/* The two paths get identical visual weight per the Phase 1 spec —
      guest play is a first-class option, not a downsell. Filled vs
      outlined distinguishes them without ranking them. */}
  <div id="login-chooser" class="grid gap-3 sm:grid-cols-2">
    <button
      type="button"
      id="show-email-btn"
      class="group flex flex-col gap-1 border border-[var(--color-charcoal)] bg-[var(--color-charcoal)] px-5 py-4 text-left text-[var(--color-bg)] transition-opacity hover:opacity-90"
    >
      <span class="text-base font-semibold">Sign in with email →</span>
      <span class="text-xs opacity-70">Notes, history, and progress</span>
    </button>
    <a
      href="/play"
      class="group flex flex-col gap-1 border border-[var(--color-charcoal)] px-5 py-4 text-left text-[var(--color-charcoal)] transition-colors hover:bg-[var(--color-bg-soft)]"
    >
      <span class="text-base font-semibold">Play as guest →</span>
      <span class="text-xs text-[var(--color-text-muted)]">Straight into the game</span>
    </a>
  </div>

  {/* Quieted right down (2026-08-19): this was two three-item bulleted
      columns at body size, which out-shouted the buttons above it. Same
      information, set as fine print, so the eye lands on the choice. */}
  <dl id="login-benefits" class="mt-7 grid gap-x-8 gap-y-4 text-center text-xs leading-relaxed sm:grid-cols-2">
    <div>
      <dt class="mb-1.5 font-medium uppercase tracking-[0.14em] text-[var(--color-text-muted)]">Signed in</dt>
      <dd class="m-0 text-[var(--color-text-soft)]">
        Revision notes unlock for every module you play · scores and history stick around · flashcards and spaced repetition coming
      </dd>
    </div>
    <div>
      <dt class="mb-1.5 font-medium uppercase tracking-[0.14em] text-[var(--color-text-muted)]">As a guest</dt>
      <dd class="m-0 text-[var(--color-text-soft)]">
        The full game, same ladder and lifelines · state lives in this tab only · sign in later and your guest history folds in
      </dd>
    </div>
  </dl>

  <div id="email-form-wrap" class={errorMessage ? "mt-8 border-t border-[var(--color-border)] pt-7" : "mt-8 border-t border-[var(--color-border)] pt-7 hidden"}>
    <form id="login-form" class="mx-auto max-w-sm space-y-3" novalidate>
      <div>
        <label for="email" class="mb-2 block text-sm font-medium">Your email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          spellcheck="false"
          class="w-full border border-[var(--color-border-soft)] bg-[var(--color-bg-soft)] px-4 py-3 text-[15px] focus:border-[var(--color-charcoal)] focus:outline-none"
          placeholder="you@example.com"
        />
      </div>
      <button
        type="submit"
        id="submit-btn"
        class="w-full bg-[var(--color-charcoal)] px-6 py-3 font-semibold text-[var(--color-bg)] hover:opacity-90 disabled:cursor-wait disabled:opacity-50"
      >
        Send me a sign-in link
      </button>
      <p class="text-xs leading-relaxed text-[var(--color-text-muted)]">
        We store your email, nickname, avatar, and play history. No tracking cookies, no third-party sharing, no selling data. <a href="/privacy" class="underline decoration-1 underline-offset-2 hover:text-[var(--color-text-soft)]">Read more →</a>
      </p>
      <p id="guest-fallback" class="hidden pt-1 text-sm text-[var(--color-text-soft)]">
        Rather not? <a href="/play" class="underline decoration-2 underline-offset-2 hover:opacity-80">Play as guest →</a>
      </p>
    </form>

    <div id="login-success" class="mx-auto mt-5 hidden max-w-sm border-l-2 border-[var(--color-functional-green)] bg-[var(--color-functional-green)]/5 px-4 py-3">
      <p class="font-semibold">Check your email</p>
      <p class="mt-1 text-sm text-[var(--color-text-soft)]">If that address is on file, a sign-in link is on its way. It expires in 10 minutes.</p>
    </div>

    <div id="login-error" class="mx-auto mt-5 hidden max-w-sm border-l-2 border-[var(--color-functional-red)] bg-[var(--color-functional-red)]/5 px-4 py-3">
      <p class="text-sm" id="login-error-text"></p>
    </div>
  </div>
</AuthLayout>

<script>
  const showEmailBtn = document.getElementById("show-email-btn") as HTMLButtonElement;
  const emailFormWrap = document.getElementById("email-form-wrap") as HTMLDivElement;
  const form = document.getElementById("login-form") as HTMLFormElement;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const successEl = document.getElementById("login-success") as HTMLDivElement;
  const errorEl = document.getElementById("login-error") as HTMLDivElement;
  const errorText = document.getElementById("login-error-text") as HTMLParagraphElement;
  const headline = document.getElementById("auth-headline") as HTMLHeadingElement;
  const subhead = document.getElementById("auth-subhead") as HTMLParagraphElement;
  const chooser = document.getElementById("login-chooser") as HTMLDivElement;
  const benefits = document.getElementById("login-benefits") as HTMLDListElement;
  const guestFallback = document.getElementById("guest-fallback") as HTMLParagraphElement;

  // Direct mode (?show=email): toggle on client-side because static
  // Astro can't read request-time query params. Hides the chooser +
  // benefits panels, expands the form, swaps the headline, surfaces
  // "Play as guest →" inside the form so the guest path stays visible.
  const params = new URLSearchParams(window.location.search);
  const directMode = params.get("show") === "email";
  if (directMode) {
    chooser.hidden = true;
    benefits.hidden = true;
    emailFormWrap.classList.remove("hidden", "mt-8", "border-t", "border-[var(--color-border)]", "pt-7");
    headline.textContent = "Sign in.";
    subhead.textContent = "Enter your email and we'll send a one-time sign-in link. No password to remember.";
    guestFallback.classList.remove("hidden");
    emailInput.focus({ preventScroll: true });
  }

  // Reveal the email form below when the user picks "Sign in with email".
  // Keeps the entry choice visually balanced — neither path is buried.
  showEmailBtn.addEventListener("click", () => {
    emailFormWrap.classList.remove("hidden");
    emailInput.focus({ preventScroll: true });
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    successEl.classList.add("hidden");
    errorEl.classList.add("hidden");

    const email = emailInput.value.trim();
    if (!email) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Sending…";

    try {
      const res = await fetch("/api/auth/send-link", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });

      if (res.ok) {
        successEl.classList.remove("hidden");
        form.classList.add("hidden");
      } else {
        const data = (await res.json().catch(() => ({}))) as { error?: string };
        errorText.textContent =
          data.error === "invalid_email"
            ? "That doesn't look like a valid email. Double-check and try again."
            : "Something went wrong sending the link. Try again in a moment.";
        errorEl.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = "Send me a sign-in link";
      }
    } catch {
      errorText.textContent = "Couldn't reach the server. Check your connection and try again.";
      errorEl.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Send me a sign-in link";
    }
  });
</script>
