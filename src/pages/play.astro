---
import BaseLayout from "../layouts/BaseLayout.astro";
import GameContainer from "../components/game/GameContainer.jsx";

// The page-level "Log in →" strip that used to sit here was removed
// (2026-08-19). It came from #19, which asked for a persistent log-in
// affordance for guests across every game screen — but that predates the
// site-wide header (#36, v0.3.1), which now renders a Sign in button (or
// the avatar chip when authenticated) on every page including this one.
// Keeping both meant a "Sign in" pill in the top bar with a "Log in →"
// button directly underneath it: the same action, twice, a few pixels
// apart, in two different visual styles and with two different words for
// it. The header satisfies #19 on its own.
//
// Deleting it also drops a duplicate /api/me request per /play load —
// the header already fetches that and caches the result in
// sessionStorage for the tab.
---
<BaseLayout title="Policy Wonk — play" zone="game">
  <GameContainer client:only="react" />
</BaseLayout>
